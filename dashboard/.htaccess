# ==============================================================================
# PM Operations Command Center — Production Directory Shield
# ==============================================================================

<IfModule mod_authz_core.c>
    # Require HTTP Basic Auth when accessed on production domain
    <If "%{HTTP_HOST} =~ /^(j\.)?synopsdigital\.com$/">
        AuthType Basic
        AuthName "Restricted PM Operations Command Center"
        AuthUserFile /home/synopsdi/public_html/list/.htpasswd
        Require valid-user
    </If>
</IfModule>
