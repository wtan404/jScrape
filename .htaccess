# DO NOT REMOVE OR EDIT. PASSENGER CONFIGURATION OPTION
# Passenger App Root
PassengerAppRoot "/home/synopsdi/public_html/list"
# Passenger Startup File
PassengerStartupFile server.js
# Passenger App Type
PassengerAppType node
# Passenger Nodejs Path
PassengerNodejs "/opt/alt/alt-nodejs18/root/usr/bin/node"

# Site-Wide HTTP Basic Authentication Shield
AuthType Basic
AuthName "jScrape Restricted Access - Authorized Personnel Only"
AuthUserFile /home/synopsdi/public_html/list/.htpasswd
Require valid-user

# Whitelist vitality/health check for automated uptime monitoring
<FilesMatch "^(health|health\.json)$">
    Require all granted
</FilesMatch>

# Enforce Subdomain-Only Access: Block any request that does not use authorized j subdomains (403 Forbidden)
<IfModule mod_authz_core.c>
    <If "%{HTTP_HOST} !~ /^(j|stage\.j)\.synopsdigital\.com$/ && %{HTTP_HOST} !~ /^(localhost|127\.0\.0\.1)/">
        Require all denied
    </If>
</IfModule>

# Enable Rewrite Engine for Passenger Proxy & Access Control
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Enforce Subdomain-Only Access: Block direct /list access and require authorized subdomains
    RewriteCond %{HTTP_HOST} !^j\.synopsdigital\.com$ [NC]
    RewriteCond %{HTTP_HOST} !^stage\.j\.synopsdigital\.com$ [NC]
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule .* - [F,L]

    # If accessed via stage subdomain, route internally to stage/
    RewriteCond %{HTTP_HOST} ^stage\.j\.synopsdigital\.com$ [NC]
    RewriteCond %{REQUEST_URI} !^/stage/
    RewriteRule ^(.*)$ stage/$1 [L]

    # Block direct path access to /stage unless accessing via stage subdomain (403 Forbidden)
    RewriteCond %{HTTP_HOST} !^stage\.j\.synopsdigital\.com$ [NC]
    RewriteRule ^stage(/.*)?$ - [F,L]

    # Route /dashboard, /dashboard/, /dsb, and /dsb/ cleanly to dsb.html
    RewriteRule ^(dashboard|dsb)/?$ dsb.html [L]
    RewriteRule ^dashboard\.html$ dsb.html [L]

    # Legacy rewrite aliases for restructured assets and data feeds
    RewriteRule ^dashboard\.js$ scripts/dashboard.js [L]
    RewriteRule ^jobs_data\.json$ dta/jobs_data.json [L]
    RewriteRule ^job_applications\.json$ dta/job_applications.json [L]
    RewriteRule ^profile\.json$ dta/profile.json [L]
    RewriteRule ^config\.json$ dta/config.json [L]
    RewriteRule ^health\.json$ dta/health.json [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ server.js [QSA,L]
</IfModule>
